import {
  "moonbitlang/moon_cove/common",
  "moonbitlang/moon_cove/collector",
  "moonbitlang/moon_cove/report",
  "moonbitlang/moon_cove/report/caret",
  "moonbitlang/moon_cove/report/cobertura",
  "moonbitlang/moon_cove/report/html",
  "moonbitlang/moon_cove/report/coveralls",
  "moonbitlang/moon_cove/report/summary",
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/io",
  "moonbitlang/async/stdio",
  "moonbitlang/x/path",
  "moonbitlang/x/sys",
}

import {
  "moonbitlang/async",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf8",
} for "wbtest"

rule(
  name: "gen_version",
  command: "moonx moonbit-community/gen_version@0.0.2 -o $output",
)

dev_build(rule: "gen_version", input: "moon.mod", output: "version.mbt")

supported_targets = "wasm+native"

pkgtype(kind: "executable")
